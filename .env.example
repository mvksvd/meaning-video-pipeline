HIGGSFIELD_MIN_CREDITS=300

# Сценарист: Claude CLI должен быть авторизован (claude)

# Скаут трендов (scripts/trend_scout.py): пул ключей Apify через запятую.
# Несколько аккаунтов Apify = несколько ключей, скрипт ротирует их сам
# при упоре в месячный лимит (у нас пул из 6 ключей).
APIFY_API_TOKENS=
# Модель судьи-классификатора (дёшево и достаточно)
TREND_SCOUT_MODEL=sonnet
